# ============================
# 饮食管理智能体 配置（终端模式）
# ============================

# 默认用户 ID（也可通过命令行参数覆盖：diet-agent <userId>）
USER_ID=tui_user

# Web 工作台仅允许绑定本机回环地址；WEB_HOST 不可设置为 0.0.0.0 或局域网地址。
WEB_HOST=127.0.0.1
WEB_PORT=4173

# ==========================================
# 模型供应商 API Key（按需填写至少一个）
# ==========================================

# --- DeepSeek（推荐，性价比高）---
# 注册: https://platform.deepseek.com/
# 可用模型: deepseek-flash, deepseek-v4-pro
DEEPSEEK_API_KEY=

# --- 智谱 GLM（推荐，国内访问稳定）---
# 注册: https://open.bigmodel.cn/
# 可用模型: glm-4.5-air, glm-4.7, glm-5-turbo, glm-5.1
ZAI_API_KEY=

# --- OpenAI（GPT 系列）---
OPENAI_API_KEY=

# --- Anthropic（Claude 系列）---
ANTHROPIC_API_KEY=

# --- OpenRouter（聚合网关，可访问多种模型）---
# 注册: https://openrouter.ai/
# 可用模型: deepseek/deepseek-chat, google/gemini-2.5-flash 等
OPENROUTER_API_KEY=

# --- Moonshot (Kimi) ---
# MOONSHOT_API_KEY=

# ==========================================
# 模型选择（可选，不填则自动检测）
# ==========================================
# MODEL_PROVIDER=deepseek   # 可选: deepseek, zai, openai, anthropic, openrouter
# MODEL_ID=deepseek-flash  # 对应 provider 下的模型 ID

# ==========================================
# 会话缓存（可选，长期运行时限制内存占用）
# ==========================================
# SESSION_MAX_COUNT=100       # 最多保留的活跃用户会话数，超出后按 LRU 淘汰
# SESSION_TTL_MS=1800000      # 会话空闲过期时间，默认 30 分钟

# ==========================================
# RAG 语义召回（可选，菜谱多时提升模糊查询召回）
# ==========================================
# 默认不启用向量，只使用 FTS5/BM25；必须显式设置 provider 才会调用 API 或加载本地模型。
# EMBEDDING_PROVIDER=local    # 可选: openai, zai, local, off
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # OpenAI，1536 维
# ZAI_EMBEDDING_MODEL=embedding-3                 # 智谱 GLM，1024 维
# 本地模型为可选能力：先运行 npm install @huggingface/transformers，再设置 local。
# 首次联网下载 bge-small-zh-v1.5 到 data/model-cache，之后可离线使用；512 维。
# DIET_AGENT_OFFLINE=1       # 强制离线；缓存不完整时给出明确错误，不尝试下载

# ==========================================
# 调试日志（默认关闭）
# ==========================================
# 请求日志可能包含完整饮食记录、健康备注和模型响应，仅调试时临时开启。
# ENABLE_REQUEST_LOGGING=1
