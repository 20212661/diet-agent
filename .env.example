# ============================
# 饮食管理智能体 MVP 配置
# ============================

# 用户名（默认 tui_user）
# USER_ID=my_name

# ==========================================
# 模型供应商 API Key（按需填写至少一个）
# ==========================================

# --- DeepSeek（推荐，性价比高）---
# 注册: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# --- 智谱 GLM（推荐，国内访问稳定）---
# 注册: https://open.bigmodel.cn/
ZAI_API_KEY=

# --- OpenAI（GPT 系列）---
OPENAI_API_KEY=

# --- Anthropic（Claude 系列）---
ANTHROPIC_API_KEY=

# --- OpenRouter（聚合网关，可访问多种模型）---
OPENROUTER_API_KEY=

# --- FatSecret（菜谱+营养查询）---
# 注册: https://platform.fatsecret.com/
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# ==========================================
# 模型选择（可选，不填则自动检测）
# ==========================================
# MODEL_PROVIDER=deepseek   # 可选: deepseek, zai, openai, anthropic, openrouter
# MODEL_ID=deepseek-v4-flash  # 对应 provider 下的模型 ID

# ==========================================
# 请求诊断日志（默认关闭）
# ==========================================
# ENABLE_REQUEST_LOGS=1
# REQUEST_LOG_RETENTION_DAYS=7
# 可选：用于日志中的成本粗估，单位为 USD / 1M tokens
# LLM_INPUT_COST_PER_MILLION=
# LLM_OUTPUT_COST_PER_MILLION=
# LLM_CACHE_READ_COST_PER_MILLION=
