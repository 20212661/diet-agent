# ============================
# 饮食管理智能体 配置（终端模式）
# ============================

# 默认用户 ID（也可通过命令行参数覆盖：diet-agent <userId>）
USER_ID=tui_user

# ==========================================
# 模型供应商 API Key（按需填写至少一个）
# ==========================================

# --- DeepSeek（推荐，性价比高）---
# 注册: https://platform.deepseek.com/
# 可用模型: deepseek-v4-flash, deepseek-v4-pro
DEEPSEEK_API_KEY=

# --- 智谱 GLM（推荐，国内访问稳定）---
# 注册: https://open.bigmodel.cn/
# 可用模型: glm-4.5-air, glm-4.7, glm-5-turbo, glm-5.1
ZAI_API_KEY=

# --- OpenAI（GPT 系列）---
OPENAI_API_KEY=

# --- Anthropic（Claude 系列）---
ANTHROPIC_API_KEY=

# --- OpenRouter（聚合网关，可访问多种模型）---
# 注册: https://openrouter.ai/
# 可用模型: deepseek/deepseek-chat, google/gemini-2.5-flash 等
OPENROUTER_API_KEY=

# --- Moonshot (Kimi) ---
# MOONSHOT_API_KEY=

# ==========================================
# 模型选择（可选，不填则自动检测）
# ==========================================
# MODEL_PROVIDER=deepseek   # 可选: deepseek, zai, openai, anthropic, openrouter
# MODEL_ID=deepseek-v4-flash  # 对应 provider 下的模型 ID

# ==========================================
# RAG 语义召回（可选，菜谱多时提升模糊查询召回）
# ==========================================
# 不填则按已配置的 key 自动选（国内优先 ZAI，其次 OpenAI）；都无则自动用本地模型（bge-small-zh）。
# 即：仅配 DeepSeek（无 embedding key）也能跑完整 hybrid —— 向量走本地、对话走 DeepSeek。
# EMBEDDING_PROVIDER=local    # 可选: openai, zai, local, off（off=关向量通道，纯 FTS5 关键词召回）
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # OpenAI，1536 维
# ZAI_EMBEDDING_MODEL=embedding-3                 # 智谱 GLM，1024 维
# 本地模型（local）：首次联网下载 bge-small-zh-v1.5 约 40MB 到 data/model-cache，之后离线；512 维。
