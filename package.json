{
  "name": "diet-agent",
  "version": "1.0.0",
  "description": "🍳 晚饭工作流 — 智能饮食管理助手（终端模式），一个命令启动",
  "main": "dist/tui/index.js",
  "bin": {
    "diet-agent": "./bin/diet.js"
  },
  "preferGlobal": true,
  "scripts": {
    "start": "tsx src/tui/index.ts",
    "tui": "tsx src/tui/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "diet": "node bin/diet.js"
  },
  "keywords": [
    "diet",
    "agent",
    "ai",
    "tui"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.75.5",
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@earendil-works/pi-tui": "^0.75.5",
    "@types/node": "^25.9.1",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "sqlite-vec": "^0.1.9",
    "tsx": "^4.22.3",
    "typebox": "^1.1.38",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  }
}
