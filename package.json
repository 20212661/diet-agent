    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@earendil-works/pi-tui": "^0.75.5",
    "@types/node": "^25.9.1",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.22.3",
    "typebox": "^1.1.38",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
