{
  "name": "diet-agent",
  "version": "1.0.0",
  "description": "🍳 晚饭工作流 — 智能饮食管理助手，一个命令启动",
  "main": "dist/tui/index.js",
  "bin": {
    "diet-agent": "./bin/diet.js"
  },
  "preferGlobal": true,
  "scripts": {
