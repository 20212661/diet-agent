    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx src/tests/core.test.ts",
    "diet": "node bin/diet.js"
  },
  "keywords": [
    "diet",
    "agent",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
